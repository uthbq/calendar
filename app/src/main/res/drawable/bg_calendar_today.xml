<?xml version="1.0" encoding="utf-8"?>
<!--
    Фон для СЕГОДНЯШНЕГО дня в календаре (когда пользователь кликнул на какую-то другую дату,
    чтобы всё равно было сразу видно, какое сегодня число).
    На квадратном элементе 32dp x 32dp фигура oval рисует аккуратное колечко.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <!-- Тонкая цветная обводка по краю круга.
         Единица dp (density-independent pixels) нужна, чтобы толщина линии выглядела одинаково
         и на старых экранах, и на экранах с высоким разрешением -->
    <stroke
        android:width="1.5dp"
        android:color="#3F51B5" />
    <!-- Внутри кружок оставляем полностью прозрачным (используем встроенный системный цвет),
         чтобы под ним спокойно просвечивал фон карточки календаря и в светлой, и в тёмной теме -->
    <solid android:color="@android:color/transparent" />
</shape>