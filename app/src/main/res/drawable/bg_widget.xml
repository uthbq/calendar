<?xml version="1.0" encoding="utf-8"?>
<!--
    Фон-карточка для виджета на рабочем столе (подключается в res/layout/widget_tasks.xml).
    Важная особенность Android: обычный CardView внутри виджетов (RemoteViews) не поддерживается,
    поэтому эффект аккуратной карточки со скруглёнными углами и рамкой делаем через <shape rectangle>.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <!-- Цвет фона берём из ресурса @color/cal_card_bg (а не жёстким кодом #FFFFFF),
         благодаря чему виджет сам становится белым в светлой теме и тёмно-серым в тёмной -->
    <solid android:color="@color/cal_card_bg" />

    <!-- Скругляем все четыре угла карточки радиусом 16dp в стиле современных виджетов Android -->
    <corners android:radius="16dp" />

    <!-- Тонкая полупрозрачная рамка по краю, чтобы виджет не сливался со светлыми или тёмными обоями рабочего стола.
         В 8-значном коде цвета #337986CB первые две цифры (33) — это прозрачность (примерно 20%),
         а остальные шесть (7986CB) — сам сине-фиолетовый цвет -->
    <stroke
        android:width="1dp"
        android:color="#337986CB" />
</shape>